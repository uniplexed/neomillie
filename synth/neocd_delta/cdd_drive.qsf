# Synthesis-only: the CD drive model (cdd_drive, and cdd_tick in the same file) on the Pocket device.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY cdd_drive
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files/cdd_drive
set_global_assignment -name SEARCH_PATH ../../rtl/cd
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cd/cdd_drive.sv
