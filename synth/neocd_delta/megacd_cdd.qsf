# Synthesis-only: Pocket Mega CD drive emulation (megacd_cdd_drive) on the Pocket device.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY megacd_cdd_drive
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files/megacd_cdd
set_global_assignment -name SYSTEMVERILOG_FILE ../../upstream/openfpga-megacd/src/fpga/core/megacd_cdd_drive.sv
